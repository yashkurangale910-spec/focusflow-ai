{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server.js"
        }
    ],
    "env": {
        "PORT": "5000",
        "JWT_SECRET": "@jwt-secret",
        "OPENAI_API_KEY": "@openai-api-key"
    }
}
# MongoDB Connection (Replace with your own URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/focusflow

# JWT Secret (Use a secure random string)
JWT_SECRET=your_jwt_secret_here

# OpenAI API Key (Get one from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=development
